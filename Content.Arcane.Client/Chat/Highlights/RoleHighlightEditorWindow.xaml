<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                      MinSize="460 360">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="8">
        <Label Text="{Loc 'role-highlight-editor-description'}"
               HorizontalExpand="True"
               Margin="0 0 0 6" />
        <TextEdit Name="HighlightsInput"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  MinHeight="220" />
        <Label Name="ValidationLabel"
               HorizontalExpand="True"
               Visible="False"
               Margin="0 6 0 0" />
        <Button Name="SaveButton"
                Text="{Loc 'role-highlight-editor-save'}"
                HorizontalAlignment="Right"
                Margin="0 8 0 0" />
    </BoxContainer>
</controls:FancyWindow>
