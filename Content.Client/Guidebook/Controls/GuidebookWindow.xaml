<!-- Arcane-Edit-Start: add xmlns:arcane and change MinSize from "100 200" to "640 400" -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                xmlns:fancyTree="clr-namespace:Content.Client.UserInterface.Controls.FancyTree"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                xmlns:arcane="clr-namespace:Content.Client._Arcane.Guidebook.Controls"
                SetSize="1000 700"
                MinSize="640 400"
                Resizable="True"
                Title="{Loc 'guidebook-window-title'}">
    <!-- Arcane-Edit-End -->
    <!-- Arcane-Start -->
    <BoxContainer Orientation="Vertical">
    <arcane:GuidebookToolbar Name="WorkspaceToolbar" />
    <BoxContainer Name="ContentHost" VerticalExpand="True">
    <!-- Arcane-End -->
    <SplitContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Name="Split"> <!-- Arcane-Edit: unnamed > Name="Split" -->
        <!-- Guide select -->
        <BoxContainer Orientation="Horizontal" Name="TreeBox" MinWidth="140"> <!-- Arcane-Edit: no minimum > MinWidth="140" -->
            <ScrollContainer HScrollEnabled="True" HorizontalExpand="True" VerticalExpand="True"> <!-- Arcane -->
            <fancyTree:FancyTree Name="Tree" VerticalExpand="True" HorizontalExpand="True" Access="Public"/>
            </ScrollContainer> <!-- Arcane -->
            <controls:Separator StyleClasses="LowDivider" Margin="0 -2" Orientation="Vertical" MinHeight="5"/>
        </BoxContainer>
        <BoxContainer Name="ArticleBox" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"> <!-- Arcane-Edit: unnamed > Name="ArticleBox" -->
            <fancyTree:FancyTree Name="TableOfContents" HorizontalExpand="True"/>
            <BoxContainer Name="SearchContainer" Visible="False" HorizontalExpand="True">
                <LineEdit
                    Name="SearchBar"
                    PlaceHolder="{Loc 'guidebook-filter-placeholder-text'}"
                    HorizontalExpand="True"
                    Margin="0 5 10 5">
                </LineEdit>
            </BoxContainer>
            <BoxContainer Access="Internal" Name="ReturnContainer" Orientation="Horizontal" HorizontalAlignment="Right" Visible="False">
                <Button Name="HomeButton" Text="{Loc 'ui-rules-button-home'}" Margin="0 0 10 0"/>
            </BoxContainer>
            <ScrollContainer Name="Scroll" HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                <Control>
                    <BoxContainer Orientation="Vertical" Name="EntryContainer" Margin="5 5 5 5" Visible="False">
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" Name="Placeholder" Margin="5 5 5 5">
                        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Loc 'guidebook-placeholder-text'}"/>
                        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Loc 'guidebook-placeholder-text-2'}"/>
                    </BoxContainer>
                </Control>
            </ScrollContainer>
        </BoxContainer>
    </SplitContainer>
    <!-- Arcane-Start -->
    </BoxContainer>
    </BoxContainer>
    <!-- Arcane-End -->
</controls:FancyWindow>
