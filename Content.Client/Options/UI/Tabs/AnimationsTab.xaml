<!-- Arcane-Start -->
<tabs:AnimationsTab xmlns="https://spacestation14.io"
                    xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
                    xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
                <Label Text="{Loc 'ui-motion-page-description'}" StyleClasses="LabelSubtext" />
                <ui:OptionDropDown Name="MotionProfile" Title="{Loc 'ui-motion-profile'}" />
                <Label Name="MotionProfileDescription" StyleClasses="LabelSubtext" Margin="0 0 0 8" />
                <BoxContainer Name="MotionOptions" Orientation="Vertical" />
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:AnimationsTab>
<!-- Arcane-End -->
