<tabs:MiscTab xmlns="https://spacestation14.io"
              xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8" VerticalExpand="True">
                <!-- Arcane-Edit-Start: name localized control for culture refresh -->
                <Label Name="GeneralUiStyleLabel" Text="{Loc 'ui-options-general-ui-style'}"
                       StyleClasses="LabelKeyText"/>
                <!-- Arcane-Edit-End -->
                <ui:OptionDropDown Name="DropDownLanguage" Title="{Loc 'ui-options-language'}" /> <!-- Arcane -->
                <ui:OptionDropDown Name="DropDownHudTheme" Title="{Loc 'ui-options-hud-theme'}" />
                <ui:OptionDropDown Name="DropDownHudLayout" Title="{Loc 'ui-options-hud-layout'}" />
                <!-- Arcane-Edit-Start: name localized control for culture refresh -->
                <Label Name="GeneralDiscordLabel" Text="{Loc 'ui-options-general-discord'}"
                       StyleClasses="LabelKeyText"/>
                <!-- Arcane-Edit-End -->
                <CheckBox Name="DiscordRich" Text="{Loc 'ui-options-discordrich'}" />
                <!-- Arcane-Edit-Start: name localized control for culture refresh -->
                <Label Name="GeneralSpeechLabel" Text="{Loc 'ui-options-general-speech'}"
                       StyleClasses="LabelKeyText"/>
                <!-- Arcane-Edit-End -->
                <CheckBox Name="ShowOocPatronColor" Text="{Loc 'ui-options-show-ooc-patron-color'}" />
                <CheckBox Name="ShowLoocAboveHeadCheckBox" Text="{Loc 'ui-options-show-looc-on-head'}" />
                <CheckBox Name="FancySpeechBubblesCheckBox" Text="{Loc 'ui-options-fancy-speech'}" />
                <CheckBox Name="FancyNameBackgroundsCheckBox" Text="{Loc 'ui-options-fancy-name-background'}" />
                <!-- <Trauma> -->
                <CheckBox Name="LogInChatCheckBox" Text="{Loc 'ui-options-log-in-chat'}" />
                <CheckBox Name="CoalesceIdenticalMessagesCheckBox" Text="{Loc 'ui-options-coalesce-identical-messages'}" />
                <CheckBox Name="DetailedExamineCheckBox" Text="{Loc 'ui-options-detailed-examine'}" />
                <!-- <.Trauma> -->
                <CheckBox Name="ChatFollowButton" Text="{Loc 'ui-options-chat-follow-button'}" />
                <!-- Arcane-Edit-Start: name localized control for culture refresh -->
                <Label Name="GeneralCursorLabel" Text="{Loc 'ui-options-general-cursor'}"
                       StyleClasses="LabelKeyText"/>
                <!-- Arcane-Edit-End -->
                <CheckBox Name="ShowHeldItemCheckBox" Text="{Loc 'ui-options-show-held-item'}" />
                <CheckBox Name="ShowCursorCooldownCheckBox" Text="{Loc 'ui-options-show-cursor-cooldown'}" /> <!-- Arcane -->
                <CheckBox Name="ShowCombatModeIndicatorsCheckBox" Text="{Loc 'ui-options-show-combat-mode-indicators'}" />
                <!-- Arcane-Edit-Start: name localized control for culture refresh -->
                <Label Name="GeneralStorageLabel" Text="{Loc 'ui-options-general-storage'}"
                       StyleClasses="LabelKeyText"/>
                <!-- Arcane-Edit-End -->
                <CheckBox Name="OpaqueStorageWindowCheckBox" Text="{Loc 'ui-options-opaque-storage-window'}" />
                <CheckBox Name="StaticStorageUI" Text="{Loc 'ui-options-static-storage-ui'}" />
                <!-- Arcane-Edit-Start: name localized control for culture refresh -->
                <Label Name="PreferencesLabel" Text="{Loc 'ui-options-preferences'}"
                       StyleClasses="LabelKeyText"/>
                <!-- Arcane-Edit-End -->
                <!-- Goobstation Edit Start -->
                <CheckBox Name="AutoFocusSearchOnBuildMenuCheckBox" Text="{Loc 'ui-options-auto-focus-search-on-build-menu'}" />
                <!-- Goobstation Edit End -->
                <!-- <CheckBox Name="ToggleWalk" Text="{Loc 'ui-options-hotkey-toggle-walk'}" /> -->
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:MiscTab>
