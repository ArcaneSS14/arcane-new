blend_mode multiply;

const highp float STRENGTH = 2.0;

// light.swsl without the screen copy. This blend mode gives scene * (1 + colour) at zero alpha,
// so the glow fades on dark backgrounds on its own.
void fragment() {
    highp vec4 sprite = zTexture(UV);

    if (sprite.a == 0.0) {
        discard;
    }

    highp vec3 warm = min(sprite.rgb * 10.0, vec3(1.0)) * vec3(0.85, 0.9, 0.9);
    COLOR = vec4(warm * sprite.a * MODULATE.a * STRENGTH, 0.0);
}
