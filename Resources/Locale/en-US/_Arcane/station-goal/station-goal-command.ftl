cmd-sendstationgoal-help = Usage: sendstationgoal <station EntityUid> <goal ID>
cmd-sendstationgoal-arg-station = <Station EntityUid>
cmd-sendstationgoal-arg-id = <Goal ID>
cmd-sendstationgoal-no-goal = No station goal found with ID { $id }.
cmd-sendstationgoal-not-sent = The station goal was not received by any fax of the station.
