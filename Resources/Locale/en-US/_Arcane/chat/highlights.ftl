role-highlight-editor-title = Highlight editor — {$job}
role-highlight-editor-open-tooltip = Edit automatic chat highlights
role-highlight-editor-description = Enter one highlight per line. Leave the editor empty to use the role defaults.
role-highlight-editor-save = Save
role-highlight-editor-too-long = Highlights cannot exceed {$max} characters in total.
role-highlight-editor-save-failed = Could not save highlights. Check the client log for details.
role-highlight-editor-help =
    Enter one expression per line.
    Wrap an expression in quotation marks to match only a complete word.
    Prefix a name with @ to avoid highlighting that name when the named character is speaking.

# Compatibility alias for the job prototype ID used by automatic highlights.
highlights-nanotrasenrepresentative = { highlights-nanotrasen-representative }
